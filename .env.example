# Copy to .env and fill in. Precedence: CLI arguments > environment variables > .env > defaults.

# --- What to watch -------------------------------------------------------------------------
IMAX_MOVIE="Dune: Part Three"
# Cinema City - OC Flora (Prague)
IMAX_CINEMA_ID=1052
# Inclusive range. Both DD.MM.YYYY and YYYY-MM-DD are accepted.
IMAX_DATE_FROM=27.12.2026
IMAX_DATE_TO=30.12.2026
IMAX_INTERVAL_MINUTES=60
# IMAX_LANG=en_GB
# IMAX_STATE_FILE=.state/notified.json
# IMAX_REQUEST_TIMEOUT_S=15
# IMAX_LOG_LEVEL=INFO

# --- Email (disabled unless host, recipients and a sender are set) ---------------------------
IMAX_SMTP_HOST=smtp.gmail.com
IMAX_SMTP_PORT=587
# starttls | ssl | none
IMAX_SMTP_SECURITY=starttls
IMAX_SMTP_USERNAME=you@gmail.com
# Gmail needs an App Password: https://myaccount.google.com/apppasswords
IMAX_SMTP_PASSWORD=app-password-here
# Defaults to IMAX_SMTP_USERNAME
# IMAX_EMAIL_FROM=you@gmail.com
# Comma-separated or a JSON list
IMAX_EMAIL_RECIPIENTS=alice@example.com,bob@example.com
# true: recipients are hidden from each other (Bcc); false: all in To
IMAX_EMAIL_USE_BCC=true

# --- Discord (disabled unless at least one webhook is set) -----------------------------------
# Comma-separated or a JSON list
IMAX_DISCORD_WEBHOOK_URLS=https://discord.com/api/webhooks/xxx/yyy
